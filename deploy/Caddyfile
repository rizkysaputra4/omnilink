# Subdomain for OmniLink Relay
# Ganti relay.findbeatradar.com jika menggunakan subdomain lain
{$RELAY_DOMAIN:relay.findbeatradar.com} {
    # Automatic TLS with Let's Encrypt / ZeroSSL
    encode zstd gzip

    # Forward WebSocket and HTTP requests to omnilink-relay
    reverse_proxy omnilink-relay:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
